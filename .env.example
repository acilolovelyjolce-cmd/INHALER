# Copy to `.env` for local use.
#
# Flutter should ONLY receive API_URL and PUBLIC_BASE_URL
# (never Mongo/JWT — those would be baked into the web bundle):
#   flutter run -d chrome --dart-define=API_URL=http://localhost:8080
#
# The API server reads the rest from the process environment:
#   cd server
#   dart run --enable-asserts bin/server.dart
# On Render, set these as service environment variables. Do not pass
# MONGODB_URI into `flutter build`.

# --- Flutter client ---
# Empty on Render web (same origin). iOS/Android release uses PUBLIC_BASE_URL
# as the live API + shop-link host — set this to your real https Render URL.
API_URL=http://localhost:8080
PUBLIC_BASE_URL=https://inhaler.onrender.com

# --- MongoDB Atlas + API (server / Render only) ---
# Atlas → Database → Connect → Drivers. URL-encode special characters in the password.
# Network Access must allow Render: 0.0.0.0/0 (or Render's outbound IPs).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.XXXX.mongodb.net/whimsical_hub?retryWrites=true&w=majority

# Long random string used to sign owner login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Created on first deploy if no owner exists (migration 002).
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
SHOP_NAME=Whimsical
SHOP_SLUG=whimsical
OWNER_BIO=Hand-finished inhaler charms with tiny dinosaur keychains.

# Render sets PORT. Local default is 8080.
PORT=8080
